    <!-- Wastelander Hidden Faction -->

    <FactionDef ParentName="FactionBase">
        <defName>FCP_Faction_Hidden_Wastelanders</defName>
        <label>Wastelanders</label>
        <pawnSingular>Wastelander</pawnSingular>
        <pawnsPlural>Wastelanders</pawnsPlural>
        <categoryTag>FCP_Wastelanders</categoryTag>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>2000</configurationListOrderPriority>
        <displayInFactionSelection>false</displayInFactionSelection>
        <fixedName>Wastelanders</fixedName>
        <factionIconPath>World/WorldObjects/Expanding/Sites/DownedRefugee</factionIconPath>
        <techLevel>Industrial</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>FCP_Backstory_Wastelander</li>
                    <li>FCP_Backstory_Wastelander_Child</li>
                </categories>
            </li>
        </backstoryFilters>
        <hidden>true</hidden>
        <rescueesCanJoin>true</rescueesCanJoin>
        <autoFlee>false</autoFlee>
        <requiredMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
        </requiredMemes>
        <disallowedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
        </disallowedMemes>
        <caravanTraderKinds>
            <li>FCP_Caravan_Crow_Trader</li>
            <li>FCP_Caravan_Crazy_Wolfgang</li>
            <li>FCP_Caravan_Doc_Hoff</li>
            <li>FCP_Caravan_Lucky_Harith</li>
            <li>FCP_Caravan_Angela_Staley</li>
            <li>FCP_Caravan_Banon</li>
            <li>FCP_Caravan_Belle_Bonny</li>
            <li>FCP_Caravan_Trashcan_Carla</li>
            <li>FCP_Caravan_Cricket</li>
            <li>FCP_Caravan_Lucas_Miller</li>
            <li>FCP_Caravan_Doc_Weathers</li>
            <li>FCP_Caravan_Crimson_Caravan_Trader</li>
            <li>FCP_Caravan_Gun_Runners_Convoy</li>
        </caravanTraderKinds>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <pawnGroupMakers>

            <!-- Wastelander -->

            <li>
                <!-- Distance fights, scout recon troopers -->
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Pawnkind_Armored_Wastelander_Combat_Armor>6</FCP_Pawnkind_Armored_Wastelander_Combat_Armor>
                    <FCP_Pawnkind_Armored_Wastelander_Combat_Armor_Modular>4</FCP_Pawnkind_Armored_Wastelander_Combat_Armor_Modular>
                    <FCP_Pawnkind_Armored_Wastelander_Combat_Armor_Reinforced>3</FCP_Pawnkind_Armored_Wastelander_Combat_Armor_Reinforced>
                    <FCP_Pawnkind_Armored_Wastelander_Combat_Armor_Reinforced_MK_II>1</FCP_Pawnkind_Armored_Wastelander_Combat_Armor_Reinforced_MK_II>
                </options>
            </li>

            <!-- Traders -->

            <li Class="FCP.Core.GroupMakerWithTraderKind">
                <kindDef>Trader</kindDef>
                <traderKinds>
                    <li>FCP_Caravan_Crimson_Caravan_Trader</li>
                    <li>FCP_Caravan_Gun_Runners_Convoy</li>
                </traderKinds>
                <traders>
                    <FCP_Pawnkind_Wastelander_Trader>1</FCP_Pawnkind_Wastelander_Trader>
                </traders>
                <carriers>
                    <FCP_Animal_Brahmin>6</FCP_Animal_Brahmin>
                </carriers>
                <guards>
                    <FCP_Pawnkind_Wastelander_Caravan_Guard>5</FCP_Pawnkind_Wastelander_Caravan_Guard>
                </guards>
                <characterDefs>
                    <li>FCP_Character_Crow</li>
                    <li>FCP_Character_Crazy_Wolfgang</li>
                    <li>FCP_Character_Doc_Hoff</li>
                    <li>FCP_Character_Lucky_Harith</li>
                    <li>FCP_Character_Angela_Staley</li>
                    <li>FCP_Character_Banon</li>
                    <li>FCP_Character_Belle_Bonny</li>
                    <li>FCP_Character_Cricket</li>
                    <li>FCP_Character_Lucas_Miller</li>
                    <li>FCP_Character_Doc_Weathers</li>
                </characterDefs>
                <characterTraderKinds>
                    <li>
                        <key>FCP_Character_Crow</key>
                        <value>FCP_Caravan_Crow_Trader</value>
                    </li>
                    <li>
                        <key>FCP_Character_Crazy_Wolfgang</key>
                        <value>FCP_Caravan_Crazy_Wolfgang</value>
                    </li>
                    <li>
                        <key>FCP_Character_Doc_Hoff</key>
                        <value>FCP_Caravan_Doc_Hoff</value>
                    </li>
                    <li>
                        <key>FCP_Character_Lucky_Harith</key>
                        <value>FCP_Caravan_Lucky_Harith</value>
                    </li>
                    <li>
                        <key>FCP_Character_Angela_Staley</key>
                        <value>FCP_Caravan_Angela_Staley</value>
                    </li>
                    <li>
                        <key>FCP_Character_Banon</key>
                        <value>FCP_Caravan_Banon</value>
                    </li>
                    <li>
                        <key>FCP_Character_Belle_Bonny</key>
                        <value>FCP_Caravan_Belle_Bonny</value>
                    </li>
                    <li>
                        <key>FCP_Character_Cricket</key>
                        <value>FCP_Caravan_Cricket</value>
                    </li>
                    <li>
                        <key>FCP_Character_Lucas_Miller</key>
                        <value>FCP_Caravan_Lucas_Miller</value>
                    </li>
                    <li>
                        <key>FCP_Character_Doc_Weathers</key>
                        <value>FCP_Caravan_Doc_Weathers</value>
                    </li>
                </characterTraderKinds>
                <characterChance>0.35</characterChance>
            </li>

            <!-- Trashcan Carla -->

            <li Class="FCP.Core.GroupMakerWithCustomTraderChar">
                <kindDef>Trader</kindDef>
                <traderKind>FCP_Caravan_Trashcan_Carla</traderKind>
                <traders>
                    <FCP_Unique_Pawnkind_Wastelander_Trader_Trashcan_Carla>1</FCP_Unique_Pawnkind_Wastelander_Trader_Trashcan_Carla>
                </traders>
                <carriers>
                    <FCP_Animal_Brahmin>1</FCP_Animal_Brahmin>
                </carriers>
                <characterDefs>
                    <li>FCP_Character_Trashcan_Carla</li>
                </characterDefs>
            </li>
        </pawnGroupMakers>
        <modExtensions Inherit="False">
            <li Class="FCP.Factions.FactionExtension_HiddenFactionHasCaravans" />
            <!-- Make them unable to use drop pods -->
            <li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
