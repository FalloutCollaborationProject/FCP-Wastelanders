<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Rivet City Settlement Traders __________-->

    <!-- Rivet City Supply -->

    <TraderKindDef>
        <defName>FCP_Trader_RivetCity_Supply</defName>
        <label>Rivet City Supply</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>1800~3500</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentIndustrial</thingDef>
                <countRange>25~60</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>300~700</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Plasteel</thingDef>
                <countRange>20~60</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Cloth</thingDef>
                <countRange>100~300</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Chemfuel</thingDef>
                <countRange>50~200</countRange>
            </li>

            <!-- Resources -->
            <li Class="StockGenerator_Category">
                <categoryDef>ResourcesRaw</categoryDef>
                <thingDefCountRange>3~5</thingDefCountRange>
                <totalPriceRange>400~900</totalPriceRange>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Manufactured</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>300~700</totalPriceRange>
            </li>

            <!-- Ballistic Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.BallisticWeapons">
                <thingDefs>
                    <li>FCP_Gun_10mm_Pistol</li>
                    <li>FCP_Gun_Chinese_Pistol</li>
                    <li>FCP_Gun_32_Hunting_Rifle</li>
                    <li>FCP_Gun_10mm_SMG</li>
                </thingDefs>
            </li>

            <!-- Vanilla Weapons -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponRanged</tradeTag>
                <countRange>2~4</countRange>
            </li>

            <!-- Wasteland Clothing -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Wasteland_Wanderer_Outfit</li>
                    <li>FCP_Apparel_Caravaneer_Outfit</li>
                    <li>FCP_Apparel_Prospector_Outfit</li>
                    <li>FCP_Apparel_Surveyor_Outfit</li>
                    <li>FCP_Apparel_Field_Hand_Female_Outfit</li>
                    <li>FCP_Apparel_Field_Hand_Male_Outfit</li>
                </thingDefs>
            </li>

            <!-- Wasteland Armor -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Leather_Armor</li>
                    <li>FCP_Apparel_Metal_Armor</li>
                </thingDefs>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_Category">
                <categoryDef>ResourcesRaw</categoryDef>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Manufactured</categoryDef>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Armor</tag>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Art</tag>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- Flak 'N Shrapnel's -->

    <TraderKindDef>
        <defName>FCP_Trader_RivetCity_FlakNShrapnel</defName>
        <label>Flak 'N Shrapnel's</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>1500~3000</countRange>
            </li>

            <!-- Ballistic Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.BallisticWeapons">
                <thingDefs>
                    <li>FCP_Gun_10mm_Pistol</li>
                    <li>FCP_Gun_Combat_Shotgun</li>
                    <li>FCP_Gun_SawnOff_Shotgun</li>
                    <li>FCP_Gun_Combat_Rifle_Standard</li>
                    <li>FCP_Gun_10mm_SMG</li>
                    <li>FCP_Gun_R91_Rifle</li>
                </thingDefs>
            </li>

            <!-- Energy Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.EnergyWeapons">
                <thingDefs>
                    <li>FCP_Gun_Laser_Pistol</li>
                    <li>FCP_Gun_Laser_Rifle</li>
                    <li>FCP_Gun_Plasma_Pistol</li>
                </thingDefs>
            </li>

            <!-- Melee Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.MeleeWeapons">
                <thingDefs>
                    <li>FCP_Melee_Bat</li>
                    <li>FCP_Melee_Bat_Aluminum</li>
                    <li>FCP_Melee_Sledgehammer</li>
                    <li>FCP_Melee_Scrap_Machete</li>
                    <li>FCP_Melee_Ripper</li>
                </thingDefs>
            </li>

            <!-- Unarmed Weapons -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.UnarmedWeapons">
                <thingDefs>
                    <li>FCP_Unarmed_Boxing_Glove</li>
                    <li>FCP_Unarmed_Power_Fist</li>
                </thingDefs>
            </li>

            <!-- Vanilla Weapons -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponRanged</tradeTag>
                <countRange>4~7</countRange>
            </li>
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponMelee</tradeTag>
                <countRange>3~5</countRange>
            </li>

            <!-- Heavy Weapons (rare finds) -->
            <li Class="StockGenerator_SingleDef" MayRequire="Rick.FCP.ExplosiveWeapons">
                <thingDef>FCP_Gun_Missile_Launcher</thingDef>
                <countRange>0~1</countRange>
            </li>

            <!-- Wasteland Armor -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Leather_Armor</li>
                    <li>FCP_Apparel_Metal_Armor</li>
                    <li>FCP_Apparel_Combat_Armor</li>
                    <li>FCP_Apparel_Combat_Armor_Light</li>
                </thingDefs>
            </li>

            <!-- Wasteland Headgear -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Combat_Helmet</li>
                    <li>FCP_Apparel_Gasmask_Goggles</li>
                </thingDefs>
            </li>

            <!-- Armor -->
            <li Class="StockGenerator_Tag">
                <tradeTag>Armor</tradeTag>
                <thingDefCountRange>3~5</thingDefCountRange>
                <countRange>1~2</countRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Armor</tag>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- A Quick Fix -->

    <TraderKindDef>
        <defName>FCP_Trader_RivetCity_AQuickFix</defName>
        <label>A Quick Fix</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>1000~2000</countRange>
            </li>

            <!-- Medicine -->
            <li Class="StockGenerator_Category">
                <categoryDef>Medicine</categoryDef>
                <thingDefCountRange>2~3</thingDefCountRange>
                <countRange>25~70</countRange>
            </li>

            <!-- Medical Drugs -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Penoxycyline</thingDef>
                <countRange>5~15</countRange>
            </li>

            <!-- Stimpaks -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_Stimpak</li>
                    <li>FCP_Chem_Diluted_Stimpak</li>
                    <li>FCP_Chem_Ultra_Stimpak</li>
                </thingDefs>
            </li>

            <!-- Medical Chems -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_MedX</li>
                    <li>FCP_Chem_RadX</li>
                    <li>FCP_Chem_Radaway</li>
                    <li>FCP_Chem_Hydra</li>
                    <li>FCP_Chem_Doctors_Bag</li>
                    <li>FCP_Chem_Blood_Pack</li>
                    <li MayRequire="Rick.FCP.Plants">FCP_Chem_Healing_Powder</li>
                </thingDefs>
            </li>

            <!-- Recreational Chems -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_Jet</li>
                    <li>FCP_Chem_Buffout</li>
                    <li MayRequire="Rick.FCP.Plants">FCP_Chem_Mentats</li>
                    <li>FCP_Chem_Psycho</li>
                </thingDefs>
            </li>

            <!-- Addiction Treatment -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems,Rick.FCP.Plants">
                <thingDefs>
                    <li>FCP_Chem_Addictol</li>
                    <li>FCP_Chem_Fixer</li>
                </thingDefs>
            </li>

            <!-- Drugs -->
            <li Class="StockGenerator_Category">
                <categoryDef>Drugs</categoryDef>
                <thingDefCountRange>4~7</thingDefCountRange>
                <totalPriceRange>700~1600</totalPriceRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Drugs</tag>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Medicine</categoryDef>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- Gary's Galley -->

    <TraderKindDef>
        <defName>FCP_Trader_RivetCity_GarysGalley</defName>
        <label>Gary's Galley</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>600~1200</countRange>
            </li>

            <!-- Nuka-Cola -->
