<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Tenpenny Tower Settlement Traders __________-->

    <!-- New Urban Apparel -->

    <TraderKindDef>
        <defName>FCP_Trader_TenpennyTower_NewUrbanApparel</defName>
        <label>New Urban Apparel</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>1200~2400</countRange>
            </li>

            <!-- Pre-War and Fine Clothing -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Business_Pre_War</li>
                    <li>FCP_Apparel_Spring_Pre_War_Dress</li>
                    <li>FCP_Apparel_Spring_Pre_War_Shirt</li>
                    <li>FCP_Apparel_Fancy_Gambler_Dress</li>
                    <li>FCP_Apparel_Fancy_Gambler_Suit</li>
                    <li>FCP_Apparel_Merc_Charmer_Dress</li>
                    <li>FCP_Apparel_Merc_Charmer_Suit</li>
                </thingDefs>
            </li>

            <!-- Apparel -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>BasicClothing</tradeTag>
                <countRange>4~8</countRange>
            </li>
            <li Class="StockGenerator_MarketValue">
                <tradeTag>Clothing</tradeTag>
                <countRange>3~6</countRange>
            </li>

            <!-- Surplus Armor -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Combat_Armor</li>
                    <li>FCP_Apparel_Leather_Armor</li>
                </thingDefs>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Clothing</tag>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Textiles</categoryDef>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- Boutique Le Chic -->

    <TraderKindDef>
        <defName>FCP_Trader_TenpennyTower_BoutiqueLeChic</defName>
        <label>Boutique Le Chic</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>1500~3000</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentIndustrial</thingDef>
                <countRange>10~25</countRange>
            </li>

            <!-- General Wasteland Goods -->
            <li Class="StockGenerator_Category">
                <categoryDef>ResourcesRaw</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>300~700</totalPriceRange>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Manufactured</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>300~700</totalPriceRange>
            </li>

            <!-- Wasteland Clothing -->
            <li Class="StockGenerator_MultiDef">
                <thingDefs>
                    <li>FCP_Apparel_Wasteland_Wanderer_Outfit</li>
                    <li>FCP_Apparel_Surveyor_Outfit</li>
                    <li>FCP_Apparel_Settler_Female_Outfit</li>
                    <li>FCP_Apparel_Settler_Male_Outfit</li>
                    <li>FCP_Apparel_Leather_Coat</li>
                </thingDefs>
            </li>

            <!-- Art -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>Art</tradeTag>
                <countRange>0~2</countRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_Category">
                <categoryDef>ResourcesRaw</categoryDef>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Manufactured</categoryDef>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Art</tag>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- Cafe Beau Monde -->

    <TraderKindDef>
        <defName>FCP_Trader_TenpennyTower_CafeBeauMonde</defName>
        <label>Cafe Beau Monde</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>600~1200</countRange>
            </li>

            <!-- Nuka-Cola -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.NukaCola">
                <thingDefs>
                    <li>FCP_Nuka_Cola</li>
                    <li>FCP_Nuka_Cola_Classic</li>
                    <li>FCP_Nuka_Cola_Cherry</li>
                </thingDefs>
            </li>

            <!-- Pre-War Food -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.PreWarFood">
                <thingDefs>
                    <li>FCP_Food_Cram</li>
                    <li>FCP_Food_Blamco_Original_Flavor</li>
                    <li>FCP_Food_Insta_Mash</li>
                </thingDefs>
            </li>

            <!-- Wasteland Plants and Produce -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Plants">
                <thingDefs>
                    <li>FCP_Raw_Mutfruit</li>
                    <li>FCP_Raw_Tato</li>
                    <li>FCP_Raw_Carrot</li>
                    <li>FCP_Raw_Melon</li>
                </thingDefs>
            </li>

            <!-- Wasteland Prepared Meals -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.WastelandFood">
                <thingDefs>
                    <li>FCP_Food_Brahmin_Pot_Pie</li>
                    <li>FCP_Food_Crispy_Wings</li>
                    <li>FCP_Food_Meat_On_A_Stick</li>
                    <li>FCP_Food_Sweet_Rolls</li>
                    <li>FCP_Food_Noodle_Cup</li>
                    <li>FCP_Food_Chicken_Noodle_Cup</li>
                </thingDefs>
            </li>

            <!-- Food -->
            <li Class="StockGenerator_Category">
                <categoryDef>Foods</categoryDef>
                <thingDefCountRange>4~8</thingDefCountRange>
                <totalPriceRange>500~1200</totalPriceRange>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>FoodMeals</categoryDef>
                <thingDefCountRange>2~3</thingDefCountRange>
                <countRange>15~40</countRange>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_Category">
                <categoryDef>FoodRaw</categoryDef>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>PlantMatter</categoryDef>
            </li>

        </stockGenerators>
    </TraderKindDef>

    <!-- Wellness Center -->

    <TraderKindDef>
        <defName>FCP_Trader_TenpennyTower_WellnessCenter</defName>
        <label>Wellness Center</label>
        <stockGenerators>

            <!-- Resources -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>1000~2000</countRange>
            </li>

            <!-- Medicine -->
            <li Class="StockGenerator_Category">
                <categoryDef>Medicine</categoryDef>
                <thingDefCountRange>2~3</thingDefCountRange>
                <countRange>25~70</countRange>
            </li>

            <!-- Stimpaks -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_Stimpak</li>
                    <li>FCP_Chem_Diluted_Stimpak</li>
                    <li>FCP_Chem_Ultra_Stimpak</li>
                </thingDefs>
            </li>

            <!-- Medical Chems -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li>FCP_Chem_MedX</li>
                    <li>FCP_Chem_RadX</li>
                    <li>FCP_Chem_Radaway</li>
                    <li>FCP_Chem_Doctors_Bag</li>
                    <li MayRequire="Rick.FCP.Plants">FCP_Chem_Healing_Powder</li>
                </thingDefs>
            </li>

            <!-- Prescription and Recreational Chems -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems">
                <thingDefs>
                    <li MayRequire="Rick.FCP.Plants">FCP_Chem_Mentats</li>
                    <li>FCP_Chem_Buffout</li>
                </thingDefs>
            </li>

            <!-- Addiction Treatment -->
            <li Class="StockGenerator_MultiDef" MayRequire="Rick.FCP.Chems,Rick.FCP.Plants">
                <thingDefs>
                    <li>FCP_Chem_Addictol</li>
                    <li>FCP_Chem_Fixer</li>
                </thingDefs>
            </li>

            <!-- Buying -->
            <li Class="StockGenerator_BuyExpensiveSimple" />
            <li Class="StockGenerator_BuyTradeTag">
                <tag>Drugs</tag>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>Medicine</categoryDef>
            </li>

        </stockGenerators>
    </TraderKindDef>

